# ---------------------------------------------------------------------------
# Signal Desk — environment configuration
#
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored. NEVER commit real keys.
#
# Every variable here is read server-side only. None of these are prefixed with
# NEXT_PUBLIC_, so none of them reach the browser bundle.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Neon Postgres POOLED connection string (the one containing "-pooler").
# Neon console -> your project -> Connection Details -> "Pooled connection".
# Example: postgresql://user:pass@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Claude API -------------------------------------------------------------
#
# IMPORTANT: this is NOT your Claude.ai / Claude Code subscription.
#
# A subscription pays for YOU talking to Claude in an app. This is a server
# that has to read thousands of headlines at 3am with nobody logged in, so it
# authenticates with its own API key and is billed per token. There is no way
# to point a deployed web app at a personal subscription — that is not a thing
# the API offers, for anyone.
#
# The good news is that the LLM is OPTIONAL. See SCORING_MODE below.
#
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# How much AI to use. This is the only setting that costs money.
#
#   off       No model calls at all. COSTS NOTHING.
#             You still get: all 40 sources polled every few minutes, deduped,
#             rule-filtered, matched to tickers by symbol and company name, and
#             ranked by source quality and recency. That is a very good
#             filtered news terminal.
#             What you lose: direction, magnitude, and the second-order
#             reasoning ("this tariff hits those suppliers").
#
#   watchlist Haiku scores only items touching a watchlist ticker, plus
#             high-priority filings (8-K, 13D, NT 10-K, tender offers).
#             Modelled at roughly $5-20/month.
#
#   haiku     Haiku triages and scores everything. Modelled ~$75/month.
#
#   full      Haiku triage + Opus scoring. The full second-order reasoning.
#             Modelled $150-300/month depending on filtering.
#
# All figures are MODELLED, not measured — see docs/source-strategy.md for the
# arithmetic. /stats reports what it actually cost, and DAILY_LLM_BUDGET_USD is
# a hard stop regardless of this setting.
#
# Starts at "off" deliberately: run it free, see whether the collected signals
# are useful, and only then decide whether the reasoning is worth paying for.
#
# KNOW WHAT "off" LOOKS LIKE. Leaving this unset does not disable the tool, it
# quietly changes what the numbers mean: direction is always neutral, magnitude
# is a per-source prior rather than a judgement, and confidence is fixed at
# 0.35 — so scores cluster around 5-7 and never exceed about 10. That is not a
# calibration problem to debug, it is the arithmetic of a pipeline in which
# nothing has read the content. If every score looks low, check this first.
SCORING_MODE=off

# Hard ceiling on Claude spend per UTC day. Processing halts and logs when
# today's recorded llm_usage total exceeds this.
#
# This is a SAFETY STOP, not a target. Modelled cost for the current source
# list is roughly $5-10/day depending on how much the rule-based prefilter and
# story dedupe remove before anything reaches a model — see
# docs/source-strategy.md for the arithmetic. An earlier version of this file
# said 2.00, which was a guess made before that arithmetic existed; at 2.00 the
# pipeline would halt partway through most days.
#
# Set this to the most you are willing to spend in a day, then read actual
# measured spend on /stats and adjust down.
DAILY_LLM_BUDGET_USD=6.00

# --- Market data ------------------------------------------------------------
# "finnhub" is the V1 default: 60 req/min on the free tier, which is enough for
# the daily price backfill and the ticker listing sync. Polygon's free tier is
# ~5 req/min, which is too tight for the outcomes job.
MARKET_DATA_PROVIDER=finnhub
# https://finnhub.io/dashboard -> API Key
MARKET_DATA_API_KEY=

# --- Auth / cron ------------------------------------------------------------
# Bearer token required by POST /api/scan, /api/process, /api/outcomes.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Secret used to HMAC-sign the admin session cookie. At least 32 characters.
# Changing it signs everyone out — that is the revocation mechanism.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# The single email address allowed to sign in.
ADMIN_EMAIL=

# scrypt hash of the sign-in password. Generate with:
#   npm run set-password
# The password itself is never stored. Without both this and ADMIN_EMAIL the
# app refuses every sign-in rather than falling open.
#
# Paste the value exactly as printed, with no quotes. The parts are separated
# by dots rather than the conventional "$" for a reason: Next runs variable
# expansion over .env files, so a "$" would be read as a variable reference and
# silently deleted along with the digits after it. That failure looks exactly
# like a wrong password and logs nothing.
ADMIN_PASSWORD_HASH=

# Public origin of the deployment, no trailing slash.
# Local: http://localhost:3000   Production: https://your-app.vercel.app
APP_URL=http://localhost:3000

# --- SEC EDGAR --------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address on every request,
# and rate-limits to 10 requests/second. Requests without this are blocked.
# Format: AppName/Version (contact-email)
SEC_USER_AGENT=SignalDesk/1.0 (you@example.com)
